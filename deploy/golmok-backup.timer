[Unit]
Description=골목마켓 백업 주기 실행

[Timer]
# 매일 한국 시간 새벽 4시 30분. 시간대를 적지 않으면 서버 시계(UTC)로 해석돼 한국 시간 13:30 에 돈다.
# 정리 배치(앱 컨테이너, 한국 시간 4시)가 끝난 뒤에 받으려는 것이다.
OnCalendar=*-*-* 04:30:00 Asia/Seoul
# 그 시각에 서버가 꺼져 있었으면(랩 세션 종료 등) 켜진 뒤 한 번 실행한다.
Persistent=true
Unit=golmok-backup.service

[Install]
WantedBy=timers.target
