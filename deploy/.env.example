# 복사해서 사용:  cp .env.example .env
# .env 는 .gitignore 로 제외된다. 실제 값을 이 예시 파일에 적지 말 것.

# DuckDNS 에서 발급받은 도메인 (https:// 없이)
DOMAIN=your-subdomain.duckdns.org

# Vercel 프론트 주소 (https:// 포함, 끝에 / 없이). 여러 개면 쉼표로 구분
CORS_ALLOWED_ORIGINS=https://your-project.vercel.app

# MySQL. 서로 다른 값으로, 충분히 길게. 생성 예: openssl rand -base64 24
MYSQL_ROOT_PASSWORD=
DB_USERNAME=golmok
DB_PASSWORD=

# JWT 서명 키. 반드시 새로 생성: openssl rand -base64 32
# 로컬(~/.gradle/gradle.properties)과 같은 값을 쓰지 말 것
JWT_SECRET=

# 기본값은 GitHub Actions 가 올리는 이미지. 보통 바꿀 필요 없다
# APP_IMAGE=ghcr.io/leejiseong20/golmok-market:latest
